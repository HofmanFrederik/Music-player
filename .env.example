# ACRCloud identify project credentials (Console -> Audio & Video Recognition -> Identify)
ACR_ACCESS_KEY=
ACR_ACCESS_SECRET=
# Identify host, e.g. identify-eu-west-1.acrcloud.com (no https://, no path)
ACR_HOST=identify-eu-west-1.acrcloud.com
# Discogs personal access token (discogs.com/settings/developers) — used for
# song/album credits (who worked on it, which instruments)
DISCOGS_TOKEN=
# Spotify app Client ID (developer.spotify.com/dashboard) — public, safe to
# ship to the client; used for the PKCE "Connect Spotify" login flow
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
